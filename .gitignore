# Publish only reviewed website files and handoff documents.
/*
!/.gitignore
!/.gitattributes
!/ASSET-PROMPTS.json
!/CINEMATIC-CHECKS.json
!/CINEMATIC-FINISH-REVIEW.md
!/CINEMATIC-REDESIGN.json
!/CINEMATIC-SOURCE-CHECKS.json
!/DESIGN.md
!/POLISH-CHECKS.json
!/POLISH-SOURCE-CHECKS.json
!/POLISH-TOUCH-CHECKS.json
!/PRD.md
!/README.md
!/PRODUCT.md
!/design.json
!/시네마틱디자인검토.md
!/최종디자인검토.md
!/dist/
/dist/*
!/dist/app.js
!/dist/brand.html
!/dist/collection.html
!/dist/data.js
!/dist/favicon.svg
!/dist/index.html
!/dist/lookbook.html
!/dist/store.html
!/dist/styles.css
!/dist/assets/
/dist/assets/*
!/dist/assets/*.webp
!/dist/assets/hero.mp4
!/dist/assets/hero-sharp.mp4
!/dist/assets/fivegold-screen-v7.woff2
!/dist/assets/fivegold-film-v7.woff2
!/dist/assets/licenses/
/dist/assets/licenses/*
!/dist/assets/licenses/Manrope-OFL.txt
!/dist/assets/licenses/Wanted-Sans-OFL.txt

# Never track secrets or generated tooling.
.env
.env.*
node_modules/
__pycache__/
*.pyc
*.zip
